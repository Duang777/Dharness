+    def test_registry_rel_path_explicit_toml_file(self):
+        repo = ResolvedRepo(
+            host="github.com",
+            org="o",
+            name="n",
+            git_url="https://github.com/o/n.git",
+        )
+        client = GitRepoRegistryClient(
+            repo=repo, registry_path=Path("tasks/dataset.toml")
+        )
+        assert client._registry_rel_path() == "tasks/dataset.toml"
+
+    def _make_toml_client(
+        self,
+        tmp_path: Path,
+        *,
+        files: bool = False,
+    ) -> GitRepoRegistryClient:
+        first_digest = "a" * 64
+        second_digest = "b" * 64
+        lines = [
+            'schema_version = "1.0"',
+            "",
+            "[dataset]",
+            'name = "terminal-bench/terminal-bench-2-1"',
+            'version = "2.1"',
+            'description = "Terminal-Bench 2.1"',
+            "",
+            "[[tasks]]",
+            'name = "terminal-bench/first"',
+            f'digest = "sha256:{first_digest}"',
+            "",
+            "[[tasks]]",
+            'name = "terminal-bench/second"',
+            f'digest = "sha256:{second_digest}"',
+            "",
+            "[[tasks]]",
+            'name = "terminal-bench/first"',
+            f'digest = "sha256:{first_digest}"',
+        ]
+        if files:
+            lines.extend(
+                [
+                    "",
+                    "[[files]]",
+                    'path = "metric.py"',
+                    f'digest = "sha256:{first_digest}"',
+                ]
+            )
+
+        manifest = tmp_path / "tasks" / "dataset.toml"
+        manifest.parent.mkdir()
+        manifest.write_text("\n".join(lines))
+        repo = ResolvedRepo(
+            host="github.com",
+            org="o",
+            name="n",
+            git_url="https://github.com/o/n.git",
+            resolved_sha="c" * 40,
+        )
+        client = GitRepoRegistryClient(
+            repo=repo, registry_path=Path("tasks/dataset.toml")
+        )
+
+        @asynccontextmanager
+        async def fake_sparse_checkout(paths, sha):
+            assert paths == ["tasks/dataset.toml"]
+            assert sha == "c" * 40
+            yield tmp_path
+
+        client._sparse_checkout = fake_sparse_checkout
+        return client
+
+    @pytest.mark.parametrize(
+        "requested_name",
+        [
+            "terminal-bench-2-1",
+            "terminal-bench/terminal-bench-2-1",
+        ],
+    )
+    async def test_toml_manifest_preserves_package_task_order_and_digests(
+        self,
+        tmp_path,
+        requested_name,
+    ):
+        client = self._make_toml_client(tmp_path)
+
+        metadata = await client.get_dataset_metadata(f"{requested_name}@2.1")
+
+        assert metadata.name == "terminal-bench/terminal-bench-2-1"
+        assert metadata.version == "2.1"
+        assert metadata.description == "Terminal-Bench 2.1"
+        assert metadata.task_ids == [
+            PackageTaskId(
+                org="terminal-bench",
+                name="first",
+                ref=f"sha256:{'a' * 64}",
+            ),
+            PackageTaskId(
+                org="terminal-bench",
+                name="second",
+                ref=f"sha256:{'b' * 64}",
+            ),
+            PackageTaskId(
+                org="terminal-bench",
+                name="first",
+                ref=f"sha256:{'a' * 64}",
+            ),
+        ]
+
+    async def test_toml_manifest_rejects_wrong_dataset_name(self, tmp_path):
+        client = self._make_toml_client(tmp_path)
+
+        with pytest.raises(ValueError, match="Dataset 'other' not found"):
+            await client.get_dataset_metadata("other")
+
+    async def test_toml_manifest_rejects_wrong_dataset_version(self, tmp_path):
